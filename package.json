{
  "name": "@anter/ai-chat-sdk",
  "version": "0.1.0",
  "description": "An industry-agnostic, embeddable AI chat SDK for React applications",
  "keywords": [
    "react",
    "ai",
    "chat",
    "sdk",
    "chat-ui",
    "streaming",
    "sse",
    "llm",
    "headless"
  ],
  "license": "MIT",
  "author": "Anter AI <hello@anter.ai>",
  "homepage": "https://github.com/anter-ai/ai-chat-sdk#readme",
  "bugs": {
    "url": "https://github.com/anter-ai/ai-chat-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anter-ai/ai-chat-sdk.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js",
      "default": "./dist/headless/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./types": {
      "types": "./dist/headless/types/index.d.ts",
      "import": "./dist/headless/types/index.js",
      "default": "./dist/headless/types/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./styles-no-base.css": "./dist/styles/styles-no-base.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "eventsource-parser": "^3.0.6",
    "lucide-react": "^0.542.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.7.6",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8"
  }
}
